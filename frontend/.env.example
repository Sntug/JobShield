# G1: trang shell chưa đọc biến này; chưa có tích hợp API.
# URL công khai minh họa, sẽ đối chiếu với hợp đồng API ở G2/G5.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Mọi NEXT_PUBLIC_* có thể xuất hiện trong bundle trình duyệt.
# Không đặt mật khẩu, DATABASE_URL hoặc API key nhà cung cấp tại đây.
# Giá trị thật thuộc .env.local (đã ignore); backend secrets thuộc backend.
