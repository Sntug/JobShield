# Giá trị minh họa; chưa tạo Database hoặc tài khoản PostgreSQL.
DATABASE_URL=postgresql+psycopg://jobshield:example-password@localhost:5432/jobshield

# Database test PostgreSQL riêng biệt (không dùng cho production)
POSTGRES_TEST_URL=postgresql+psycopg://r11_review:r11_local_test@127.0.0.1:55432/jobshield_r11_review

# Danh sách domain frontend được phép gọi API (phân tách bởi dấu phẩy)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Backend đọc .env trong thư mục backend; file thật đã được ignore.
# DATABASE_URL có credential: không dùng NEXT_PUBLIC_* hoặc gửi sang frontend.
# Chưa cần API key OCR/LLM hay auth secret ở G1; sẽ thiết lập ở giai đoạn tương ứng.
